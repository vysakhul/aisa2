<Window x:Class="Aisa.App.Shell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aisa settings"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#141518"
        Foreground="#F2FFFFFF"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="Margin" Value="0,6" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#99FFFFFF" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="PLACEMENT" Style="{StaticResource Section}" Margin="0,0,0,4" />
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Position" />
            <ComboBox x:Name="AnchorBox" Grid.Column="1" SelectionChanged="OnChanged" />
        </Grid>
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition />
                <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Edge margin" />
            <Slider x:Name="EdgeMargin" Grid.Column="1" Minimum="0" Maximum="200" IsSnapToTickEnabled="True" TickFrequency="2" ValueChanged="OnChanged" />
            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=EdgeMargin, StringFormat={}{0:0} px}" HorizontalAlignment="Right" />
        </Grid>

        <TextBlock Text="BEHAVIOUR" Style="{StaticResource Section}" />
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition />
                <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Auto-close after" />
            <Slider x:Name="AutoClose" Grid.Column="1" Minimum="5" Maximum="120" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnChanged" />
            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=AutoClose, StringFormat={}{0:0} s}" HorizontalAlignment="Right" />
        </Grid>
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition />
                <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Hide peek after" />
            <Slider x:Name="CompactHide" Grid.Column="1" Minimum="2" Maximum="120" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnChanged" />
            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=CompactHide, StringFormat={}{0:0} s}" HorizontalAlignment="Right" />
        </Grid>
        <CheckBox x:Name="FaceHover" Content="Open when I rest the pointer on the face" Checked="OnChanged" Unchecked="OnChanged" />
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition />
                <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Snooze length" />
            <Slider x:Name="Snooze" Grid.Column="1" Minimum="1" Maximum="60" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnChanged" />
            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=Snooze, StringFormat={}{0:0} min}" HorizontalAlignment="Right" />
        </Grid>

        <TextBlock Text="SOUND" Style="{StaticResource Section}" />
        <CheckBox x:Name="SoundOn" Content="Interface sounds" Checked="OnChanged" Unchecked="OnChanged" />
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Interface volume" />
            <Slider x:Name="UiVolume" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="OnChanged" />
        </Grid>
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Alarm volume" />
            <Slider x:Name="AlarmVolume" Grid.Column="1" Minimum="0.05" Maximum="1" ValueChanged="OnChanged" />
        </Grid>

        <TextBlock Text="LM STUDIO (FALLBACK UNDERSTANDING)" Style="{StaticResource Section}" />
        <CheckBox x:Name="LmEnabled" Content="Ask LM Studio when I don't understand" Checked="OnChanged" Unchecked="OnChanged" />
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Server URL" />
            <TextBox x:Name="LmUrl" Grid.Column="1" LostFocus="OnChanged" />
        </Grid>
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Model (optional)" />
            <TextBox x:Name="LmModel" Grid.Column="1" LostFocus="OnChanged" ToolTip="Leave empty to use the model loaded in LM Studio" />
        </Grid>

        <TextBlock Text="SYSTEM" Style="{StaticResource Section}" />
        <CheckBox x:Name="StartWithWindows" Content="Start with Windows" Checked="OnChanged" Unchecked="OnChanged" />
    </StackPanel>
</Window>
