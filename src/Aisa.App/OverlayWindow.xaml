<Window x:Class="Aisa.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:views="clr-namespace:Aisa.App.Views"
        Title="Aisa"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="Manual"
        Width="720" Height="360"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Grid x:Name="Root">
        <!-- Hit margin: the layered window lets alpha-0 pixels fall through even when input is enabled,
             so the 14 px margin is painted at alpha 1/255 to keep a grazing cursor "on" the island. -->
        <Border x:Name="IslandHost"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Padding="14,0,14,14"
                Background="#01000000"
                MouseLeftButtonDown="OnIslandMouseDown">
            <Border x:Name="Island"
                    Background="Black"
                    CornerRadius="0,0,10,10"
                    Width="120" Height="24"
                    ClipToBounds="True">
                <Grid>
                    <!-- Greeting starfield, behind everything; only drawn during launch. -->
                    <skia:SKElement x:Name="GreetingCanvas" Width="640" Height="150" HorizontalAlignment="Center" VerticalAlignment="Top"
                                    IsHitTestVisible="False" Visibility="Collapsed" PaintSurface="OnGreetingPaint" />

                    <!-- Fixed-size content so nothing reflows while the island animates; the island clips it. -->
                    <Grid x:Name="ContentLayer" Width="640" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                        </Grid.ColumnDefinitions>

                        <!-- Header: tab, gear, speaker, close. Fades with the content. -->
                        <Grid x:Name="Header" Grid.Column="0" Grid.ColumnSpan="3" Margin="18,6,12,0">
                            <TextBlock x:Name="TabLabel" Text="Chat" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="82,0,0,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="GearButton" Content="&#xE713;" Style="{StaticResource IconButton}" Click="OnGear" ToolTip="Settings" />
                                <Button x:Name="SpeakerButton" Content="&#xE767;" Style="{StaticResource IconButton}" Click="OnSpeaker" ToolTip="Sound" />
                                <Button x:Name="CloseButton" Content="&#xE711;" Style="{StaticResource IconButton}" Click="OnClose" ToolTip="Close (Esc)" />
                            </StackPanel>
                        </Grid>

                        <!-- View host: views cross-fade (Spec 1.3). -->
                        <Grid x:Name="ViewHost" Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                            <views:ChatView x:Name="ChatPane" Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" />
                            <views:AlertView x:Name="AlertPane" Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" />
                        </Grid>

                        <!-- Greeting text sits under the dropped face. -->
                        <StackPanel x:Name="GreetingPane" Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Top"
                                    Margin="0,50,0,0" Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                            <TextBlock Text="Hi, I'm Aisa" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Your alarms and reminders live up here." Foreground="{StaticResource SubtleTextBrush}" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- Not clipped by the island: the face, its halo, particles and the countdown bar may overflow. -->
        <Canvas x:Name="OverlayLayer" IsHitTestVisible="False">
            <skia:SKElement x:Name="FaceCanvas" Width="160" Height="160" PaintSurface="OnFacePaint" />
            <Rectangle x:Name="CountdownBar" Height="2" Width="0" Fill="#59FFFFFF" RadiusX="1" RadiusY="1" Visibility="Collapsed" />
        </Canvas>
    </Grid>
</Window>
