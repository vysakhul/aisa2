<UserControl x:Class="Aisa.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chat="clr-namespace:Aisa.App.Chat">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type chat:ConfirmationCard}">
            <Border Background="#1F2A3B" CornerRadius="12" Padding="10,8" Margin="0,2,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,6" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="Set" Command="{Binding SetCommand}" Style="{StaticResource AccentButton}" Margin="0,0,6,0" />
                        <Button Content="Edit" Command="{Binding EditCommand}" Style="{StaticResource FlatButton}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Note}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"
                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type chat:UpcomingCard}">
            <Border Background="#18191D" CornerRadius="12" Padding="10,6" Margin="0,2,0,0">
                <StackPanel>
                    <TextBlock Text="Nothing coming up." Foreground="{StaticResource SubtleTextBrush}" FontSize="12"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type chat:UpcomingRow}">
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Content="&#xE711;" Command="{Binding RemoveCommand}" Style="{StaticResource IconButton}" Width="20" Height="20" FontSize="9" ToolTip="Remove" />
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Width="110" VerticalAlignment="Center" />
                                    <Border DockPanel.Dock="Right" Background="#33F5A524" CornerRadius="6" Padding="5,0" Margin="6,0" VerticalAlignment="Center"
                                            Visibility="{Binding HasTag, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding Tag}" Foreground="#F5A524" FontSize="10" />
                                    </Border>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type chat:CancelCard}">
            <Border Background="#2A1A1E" CornerRadius="12" Padding="10,6" Margin="0,2,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Question}" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Matches}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type chat:UpcomingRow}">
                                <TextBlock Foreground="{StaticResource SubtleTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Icon, Mode=OneWay}" /> <Run Text="{Binding Time, Mode=OneWay}" /> · <Run Text="{Binding Label, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Cancel it" Command="{Binding ConfirmCommand}" Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,6,0,0"
                            Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Note}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type chat:ChatMessage}">
            <Grid Margin="0,3">
                <!-- User bubble, right aligned -->
                <Border HorizontalAlignment="Right" MaxWidth="380" Background="#2B5BD7" CornerRadius="12,12,4,12" Padding="10,5"
                        Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Text}" Foreground="White" FontSize="13" TextWrapping="Wrap" />
                </Border>
                <!-- Assistant reply with optional inline card -->
                <StackPanel HorizontalAlignment="Left" MaxWidth="440"
                            Visibility="{Binding IsUser, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextBrush}" FontSize="13" TextWrapping="Wrap"
                               Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}" />
                    <ContentPresenter Content="{Binding Card}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="⏰ Set an alarm" Tag="alarm" Click="OnChip" Style="{StaticResource ChipButton}" />
            <Button Content="🔔 Remind me" Tag="remind" Click="OnChip" Style="{StaticResource ChipButton}" />
            <Button Content="📋 Upcoming" Tag="upcoming" Click="OnChip" Style="{StaticResource ChipButton}" />
        </StackPanel>

        <ScrollViewer x:Name="LogScroll" Grid.Row="1" Style="{StaticResource SlimScrollViewer}">
            <StackPanel>
                <ItemsControl x:Name="Log" ItemsSource="{Binding Messages}" />
                <TextBlock Text="•••" Foreground="{StaticResource SubtleTextBrush}" FontSize="14" Margin="2,2,0,2"
                           Visibility="{Binding IsThinking, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="12" Margin="0,6,0,0" Padding="4,2">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="&#xE724;" Style="{StaticResource IconButton}" Click="OnSend" ToolTip="Send" />
                <TextBox x:Name="Input" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                         CaretBrush="White" FontSize="13" Padding="6,5" VerticalContentAlignment="Center"
                         KeyDown="OnInputKeyDown" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
